{
  "name": "github-trending-threads",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "KV", "id": "2385d95e2ef342098419b7ca4954dc5f" }],
  // 每天更新一次 Threads token
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "PICKS_URL": "https://raw.githubusercontent.com/ewanhohou/Github-Trending/main/data/picks/",
    "PAGES_URL": "https://ewanhohou.github.io/Github-Trending/",
    // 發文的主題，留空就不設定
    "THREADS_TOPIC": "AI Threads"
  }
  // Secrets（由 .github/workflows/worker.yml 從 repo Secrets 同步）：
  // TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, THREADS_APP_ID, THREADS_APP_SECRET
}
