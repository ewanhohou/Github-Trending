{
  "name": "GitHub Trending Report",
  "short_name": "Trending",
  "description": "A daily digest of trending GitHub repos: what each one is and what it's for",
  "lang": "en",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Latest daily",
      "url": "daily/latest.html"
    },
    {
      "name": "Latest weekly",
      "url": "weekly/latest.html"
    }
  ]
}
